  get(){ try{ return localStorage.getItem("ot-theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"); }catch(e){ return "light"; } },
  set(t){ try{ localStorage.setItem("ot-theme", t); }catch(e){} document.body.classList.toggle("dark", t==="dark"); },
  toggle(btn){ const t = this.get()==="dark" ? "light" : "dark"; this.set(t); btn.textContent = t==="dark" ? "☀️" : "🌙"; },
};
