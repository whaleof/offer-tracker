        </div>
      </div>`;
  },
  saveReview(id){
    const round = $("#rv_round").value, date = $("#rv_date").value;
    const questions = $("#rv_questions").value.split(/\n+/).map(s=>s.trim()).filter(Boolean);
    const notes = $("#rv_notes").value.trim();
    if(!questions.length && !notes){ alert("至少填一道题，或写一句复盘"); return; }
    STORE.addReview(id, { round, date, questions, notes });
    UI.openDetail(id); renderMain();
  },

  toggleDemoMenu(btn){ this.closeMenu(); this.open("demoMask"); },

  /* ── AI 深度分析结果渲染 ── */
  renderPrep(text){
    if(!text) return "";
    const parts = text.split(/(?=【[^】]{1,20}】)/).map(s=>s.trim()).filter(Boolean);
    return `<div class="ana-box">${parts.map(p=>{
      const m = p.match(/^【([^】]+)】\s*([\s\S]*)$/);
      return m ? `<div class="ana-sec"><div class="ana-h">${esc(m[1])}</div><div class="ana-b">${esc(m[2]).trim()}</div></div>`
               : `<div class="ana-b">${esc(p)}</div>`;
    }).join("")}</div>`;
  },
  renderMatch(text){
    if(!text) return "";
    const lines = text.split(/\n/).map(l=>l.trim()).filter(l=>l.includes("|"));
    if(lines.length < 2) return `<div class="ana-box"><div class="ana-b">${esc(text)}</div></div>`;
    const cells = l => l.replace(/^\||\|$/g,"").split("|").map(c=>c.trim());
    const head = cells(lines[0]);
    const body = lines.slice(1).filter(l=>!/^[\s|:\-]+$/.test(l)).map(cells);
    return `<div class="ana-box" style="overflow-x:auto"><table class="matchtable">
      <thead><tr>${head.map(h=>`<th>${esc(h)}</th>`).join("")}</tr></thead>
      <tbody>${body.map(r=>`<tr>${head.map((_,i)=>`<td>${esc(r[i]||"")}</td>`).join("")}</tr>`).join("")}</tbody>
    </table></div>`;
  },

  /* ── 拖拽换状态 / 状态直改（学航海志：变更零摩擦 + 可顺手记日程） ── */
  dragCard(e, id){ e.dataTransfer.setData("text/plain", id); e.dataTransfer.effectAllowed = "move"; },
  dropCard(e, stage){
    const id = e.dataTransfer.getData("text/plain");
    if(id) this.moveStatus(id, stage);
  },
  moveStatus(id, stage){
    const j = STORE.data.jobs.find(x=>x.id===id); if(!j || j.status===stage) return;
    STORE.update(id, {}, stage);
    // 进入测评/面试 → 顺手弹时间窗（可跳过），确认后自动进月历日程
    if(stage==="test" || stage==="interview"){
      this._evJob = id;
      $("#ev-title").textContent = stageOf(stage).name + "时间 · " + (j.company||"");
      $("#ev-date").value = isoDay(today());
      $("#ev-time").value = "";
      this.open("evMask");
    }
    renderMain();
  },
  saveEvent(){
    const d = $("#ev-date").value;
    if(!d){ $("#ev-st").textContent = "选个日期，或点「跳过」"; return; }
    STORE.addEvent(this._evJob, { date:d, time:$("#ev-time").value||"", label: stageOf(STORE.data.jobs.find(x=>x.id===this._evJob).status).name });
    this.close("evMask"); renderMain();
  },

  /* ── 顶栏「更多」菜单 ── */
  toggleMenu(){
    const m = $("#moreMenu"); if(m) m.classList.toggle("show");
  },
  closeMenu(){
    const m = $("#moreMenu"); if(m) m.classList.remove("show");
  },

  /* ── AI 设置 ── */
  openAISettings(msg){
    const sel = $("#ai_provider");
    sel.innerHTML = Object.entries(CONFIG.AI_PROVIDERS)
      .map(([k,p])=>`<option value="${k}" ${AI.cfg&&AI.cfg.provider===k?"selected":""}>${p.name}</option>`).join("");
    $("#ai_key").value = (AI.cfg&&AI.cfg.key) || "";
    $("#ai_bio").value = (AI.cfg&&AI.cfg.bio) || "";
    const st = $("#ai-set-st");
    st.textContent = msg || (AI.ready()? "已配置 ✓（Key 存本机浏览器）" : "");
    st.className = "ai-status";
    this.open("aiMask");
  },
  saveAISettings(){
    const key = $("#ai_key").value.trim();
    AI.saveCfg({ provider: $("#ai_provider").value, key, bio: $("#ai_bio").value.trim() });
    this.close("aiMask");
  },
};

/* ═══════════ ⑤.5 AI 能力（DeepSeek / 智谱，OpenAI 兼容直连） ═══════════ */
const AI = {
  cfg: null,
  load(){ try{ this.cfg = JSON.parse(localStorage.getItem("ot-ai")||"null"); }catch(e){ this.cfg = null; } this.indicate(); },
  ready(){ return !!(this.cfg && this.cfg.key && this.cfg.provider); },
  indicate(){
    const b = document.getElementById("aiBtn"); if(!b) return;
    b.textContent = this.ready() ? "AI ✓" : "AI 设置";
    b.style.borderColor = this.ready() ? "var(--pink)" : "";
  },
  saveCfg(c){ this.cfg = c; try{ localStorage.setItem("ot-ai", JSON.stringify(c)); }catch(e){} this.indicate(); },
  async chat(messages, maxTokens){
    const p = CONFIG.AI_PROVIDERS[this.cfg.provider] || CONFIG.AI_PROVIDERS.deepseek;
    let res;
    try{
      res = await fetch(p.base+"/chat/completions", {
        method:"POST",
        headers:{ "Content-Type":"application/json", "Authorization":"Bearer "+this.cfg.key },
        body: JSON.stringify({ model:p.model, messages, temperature:0.5, max_tokens:maxTokens||600 }),
      });
    }catch(e){ throw new Error("网络不通（检查代理/网络后再试）"); }
    if(res.status===401) throw new Error("Key 不对或已失效（401）");
    if(res.status===402) throw new Error("账户余额不足（402），去提供方官网充值");
    if(res.status===429) throw new Error("请求太频繁（429），等几秒再试");
    if(!res.ok){ const t = await res.text(); throw new Error("接口返回 "+res.status+" "+t.slice(0,80)); }
    const d = await res.json();
    const out = d.choices && d.choices[0] && d.choices[0].message && d.choices[0].message.content;
    return (out||"").trim();
  },
  _check(){
    if(this.ready()) return true;
    UI.openAISettings("先用 AI：粘贴你的 API Key（只存本机浏览器，费用自己可控）");
    return false;
  },
  _bio(){ return (this.cfg && this.cfg.bio) || "未填写"; },

  // 复盘 AI：给被问倒的题生成答题思路，存进题库
  async advice(jobId, rIdx, qIdx, scope){
    if(!this._check()) return;
    const j = STORE.data.jobs.find(x=>x.id===jobId); if(!j) return;
    const r = j.reviews && j.reviews[rIdx]; if(!r) return;
    const q = r.questions[qIdx];
    const stId = scope+"-st-"+(scope==="dt" ? rIdx+"-"+qIdx : qIdx);
    const st = document.getElementById(stId);
    if(st){ st.textContent = "AI 思考中…"; st.className = "ai-status"; }
    try{
      const out = await this.chat([
        { role:"system", content:"你是资深面试教练。只输出干货，不要客套开场白和总结。" },
        { role:"user", content:
          `候选人在【${r.round||"面试"}】被问到：${q}\n岗位：${j.role} @ ${j.company}\n候选人亮点：${this._bio()}\n`+
          `请给答题思路：3-5 条要点，每条一行、每行不超过 25 字；最后另起一行「面试官为什么问：」+ 一句话。` }
      ], 500);
      STORE.addAdvice(jobId, rIdx, q, out);
      if(scope==="dt") UI.openDetail(jobId); else renderResults();
    }catch(e){
      if(st){ st.textContent = "生成失败："+e.message; st.className = "ai-status err"; }
    }
  },
  adviceQB(i){
    const it = (VIEWS._qitems||[])[i]; if(!it) return;
    this.advice(it.jobId, it.ri, it.qi, "qb");
  },

  // BOSS 打招呼语生成
  async greet(jobId){
    if(!this._check()) return;
    const j = STORE.data.jobs.find(x=>x.id===jobId); if(!j) return;
    const st = document.getElementById("greet-st");
    const out = document.getElementById("greetOut");
    st.textContent = "AI 生成中…"; st.className = "ai-status";
    try{
      const text = await this.chat([
        { role:"system", content:"你是求职助手。只输出打招呼语本身，不要引号、不要解释。" },
        { role:"user", content:
          `为 BOSS 直聘写一条给招聘者的打招呼语。\n岗位：${j.role} @ ${j.company}${j.city?"（"+j.city+"）":""}\n我的亮点：${this._bio()}\n简历版本：${j.resume||"默认"}\n`+
          `要求：80-140 字，口语自然、不吹嘘，突出 1-2 个与岗位的匹配点，结尾表达进一步沟通的意愿。` }
      ], 300);
      out.value = text;
      st.textContent = "";
      document.getElementById("greetSave").style.display = "";
    }catch(e){
      st.textContent = "生成失败："+e.message; st.className = "ai-status err";
    }
  },

  /* ── AI 深度分析（学航海志）：面试准备包 + 匹配度分析表，结果存岗位 ── */
  _anaSt(msg, err){
    const st = document.getElementById("ana-st"); if(!st) return;
    st.textContent = msg || ""; st.className = "ai-status" + (err ? " err" : "");
  },
  _anaBusy(busy){
    ["ana-prep-btn","ana-match-btn"].forEach(id=>{
      const b = document.getElementById(id);
      if(b){ b.disabled = busy; b.style.opacity = busy ? ".5" : ""; }
    });
  },
  _anaCtx(j){
    return `岗位：${j.role} @ ${j.company}${j.city?"（"+j.city+"）":""}\nJD 原文：\n${j.jd}\n我的亮点：${this._bio()}\n简历版本：${j.resume||"默认"}${j.notes?"\n备注："+j.notes:""}`;
  },
  async prep(jobId){
    if(!this._check()) return;
    const j = STORE.data.jobs.find(x=>x.id===jobId); if(!j || !j.jd) return;
    this._anaBusy(true); this._anaSt("AI 生成中…约 10-30 秒，生成完自动保存到岗位");
    try{
      const out = await this.chat([
        { role:"system", content:"你是资深求职教练。只输出内容本身，不要客套开场白和总结，严格按照【】分节格式输出。" },
        { role:"user", content:
          this._anaCtx(j) +
          `\n\n请生成面试准备包，严格按以下四节输出（每节用【】标题）：\n`+
          `【定制自我介绍】结合 JD 关键词和我的亮点，写一段 120 字内的开场自我介绍\n`+
          `【JD 关键词】这个岗位最看重的 5-8 个关键词，一行列出\n`+
          `【预测问题】5 个最可能被问的问题，一行一个，每个后面用「→」接一句答题要点\n`+
          `【面试前必查】3 条：面试前该查的公司信息/数据/该准备的反问` }
      ], 1000);
      STORE.setAnalysis(jobId, "prep", out);
      UI.openDetail(jobId);
    }catch(e){
      this._anaSt("生成失败："+e.message, true); this._anaBusy(false);
    }
  },
  async match(jobId){
    if(!this._check()) return;
    const j = STORE.data.jobs.find(x=>x.id===jobId); if(!j || !j.jd) return;
    this._anaBusy(true); this._anaSt("AI 生成中…约 10-30 秒，生成完自动保存到岗位");
    try{
      const out = await this.chat([
        { role:"system", content:"你是资深求职教练。只输出 markdown 表格本身，不要任何开场白和总结。表格第一行是表头，第二行是分隔行。" },
        { role:"user", content:
          this._anaCtx(j) +
          `\n\n请站在面试官视角做匹配度分析，输出 markdown 表格，三列：面试官关注维度 | 我的简历证据 | 隐患与建议。\n`+
          `要求：4-6 行；「我的简历证据」基于我的亮点写他可能认可的点，没证据就写「简历中未体现」；「隐患与建议」写面试官可能追问什么、我该怎么补，要具体可执行，不写空话。` }
      ], 1000);
      STORE.setAnalysis(jobId, "match", out);
      UI.openDetail(jobId);
    }catch(e){
      this._anaSt("生成失败："+e.message, true); this._anaBusy(false);
    }
  },
};

/* ═══════════ ⑥ IO 导入导出 ═══════════ */
const IO = {
  exportJSON(){
    const blob = new Blob([JSON.stringify(STORE.data,null,2)], {type:"application/json"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `job-tracker-备份-${new Date().toISOString().slice(0,10)}.json`;
    a.click(); URL.revokeObjectURL(a.href);
  },
  importJSON(input){
    const file = input.files[0]; if(!file) return;
    const r = new FileReader();
    r.onload = () => {
      try{
        const d = JSON.parse(r.result);
        if(!confirm(`导入「${file.name}」会覆盖当前 ${STORE.data.jobs.length} 条岗位数据，继续？`)) return;
        STORE.replaceAll(d); renderMain(); alert("导入成功，共 "+d.jobs.length+" 条");
      }catch(e){ alert("文件格式不对，导入失败"); }
    };
    r.readAsText(file); input.value="";
  },
  buildCSV(){
    // \ufeff BOM 让 Excel 正确识别 UTF-8 中文
    const head = ["公司","岗位","城市","渠道","DDL","投递日","状态","下一步","薪资","简历版本","备注"];
    const rows = STORE.data.jobs.map(j=>[
      j.company, j.role, j.city||"", j.channel||"", j.deadline||"",
      j.appliedAt? String(j.appliedAt).slice(0,10) : "",
      stageOf(j.status).name, j.next||"", j.salary||"", j.resume||"", j.notes||""
    ]);
    return "\ufeff" + [head, ...rows].map(r=>r.map(c=>`"${String(c??"").replace(/"/g,'""')}"`).join(",")).join("\r\n");
  },
  exportCSV(){
    const blob = new Blob([this.buildCSV()], {type:"text/csv;charset=utf-8"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `offer-tracker-${new Date().toISOString().slice(0,10)}.csv`;
    a.click(); URL.revokeObjectURL(a.href);
  },
  copyText(jobId){
    const j = STORE.data.jobs.find(x=>x.id===jobId); if(!j || !j.greeting) return;
    const done = ()=> alert("已复制，去 BOSS 直接粘贴即可");
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(j.greeting).then(done).catch(()=>{
        const ta = document.createElement("textarea"); ta.value = j.greeting;
        document.body.appendChild(ta); ta.select(); document.execCommand("copy");
        document.body.removeChild(ta); done();
      });
    }else{
      const ta = document.createElement("textarea"); ta.value = j.greeting;
      document.body.appendChild(ta); ta.select(); document.execCommand("copy");
      document.body.removeChild(ta); done();
    }
  },
  clearAll(){
    if(!confirm("确定清空全部岗位数据？此操作不可恢复（建议先导出备份）")) return;
    STORE.replaceAll({ version:CONFIG.DATA_VERSION, jobs:[] }); renderMain();
  },
};

