<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Offer Tracker · 秋招作战板</title>
<!--
  ════════════════════════════════════════════════════════
  Offer Tracker（秋招作战板）· 单文件应用（无后端 / localStorage 存储）
  仓库: offer-tracker · 数据安全：全部存在本机浏览器 localStorage，
  可随时「导出备份」成 JSON；真实数据包 my-data.json 永不进仓库。
  演示模式：一键填充脱敏假数据，供作品集展示；清空即可恢复真实数据。

  ── 扩展指南（AI/未来维护者读这里）──
  ① 加/改状态列      → 只改 CONFIG.STAGES
  ② 加岗位字段       → 只改 CONFIG.FIELDS + renderForm 的表单生成
  ③ 加新视图/功能块  → 在 VIEWS 区加函数 + 在 renderMain 里挂载
  ④ 数据结构变更     → CONFIG.DATA_VERSION +1，在 STORE.migrate 里写迁移
  ════════════════════════════════════════════════════════
-->
<style>
  :root{
    /* ── UI v2 规范（2026-09-07 定稿）· 暖白底 + 樱花粉唯一强调 ── */
    --paper:#F5F4F0; --paper-2:#EFEEE9; --paper-3:#EAE8E2; --card:#FFFFFF; --header-bg:rgba(245,244,240,.94);
    --ink:#3a2a30; --ink-mid:#7a6a72; --ink-light:#9a7a85;
    --brand:#c2416b; --brand-deep:#a83358; --brand-soft:#fdeef3;
    --accent:#D4537E; --accent-deep:#b83f66; --accent-soft:#fbe4ec;
    --ok:#639922; --warn:#BA7517; --bad:#E24B4A; --info:#378ADD;
    --line:rgba(58,42,48,.12); --line-strong:rgba(58,42,48,.20);
    /* 圆角三级制：卡片 18 / 控件 8 / 药丸全圆 */
    --radius:14px; --radius-card:18px; --radius-btn:8px; --radius-pill:9999px;
    /* 兼容旧名，原有样式自动跟随新主题 */
    --pink:var(--brand); --pink-deep:var(--brand-deep); --pink-bg:var(--paper); --pink-card:var(--paper-3);
  }
  body.dark{
    --paper:#232022; --paper-2:#2B2729; --paper-3:#332E31; --card:#2C282B; --header-bg:rgba(35,32,34,.94);
    --ink:#EFE7EA; --ink-mid:#B5A8AE; --ink-light:#8A7C83;
    --brand:#E06A90; --brand-deep:#C9537A; --brand-soft:#3A2A31;
    --accent:#E06A90; --accent-deep:#C9537A; --accent-soft:#3A2A31;
    --ok:#8CBF55; --warn:#D9A34A; --bad:#E87A78; --info:#6BA5E8;
    --line:rgba(239,231,234,.14); --line-strong:rgba(239,231,234,.24);
    /* 别名必须在 body.dark 重定义一次：:root 上的 var() 引用在 html 层就解析了，body 换 --paper 影响不到它们 */
    --pink:var(--brand); --pink-deep:var(--brand-deep); --pink-bg:var(--paper); --pink-card:var(--paper-3);
  }
  *{margin:0;padding:0;box-sizing:border-box;font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif}
  body{background:var(--pink-bg);color:var(--ink);min-height:100vh;padding-bottom:60px}
  button{cursor:pointer;border:none;font-family:inherit}
  input,select,textarea{font-family:inherit;font-size:14px;color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:8px 10px;background:var(--card);outline:none;width:100%}
  input:focus,select:focus,textarea:focus{border-color:var(--pink)}

  /* ── header ── */
  header{position:sticky;top:0;z-index:20;background:var(--header-bg);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);padding:14px 20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  header h1{font-size:18px;color:var(--pink-deep);font-weight:600}
  header .sub{font-size:12px;color:var(--ink-light)}
  .hbtns{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}
  .btn{background:var(--card);border:1px solid var(--line);color:var(--pink-deep);border-radius:8px;padding:7px 14px;font-size:13px;transition:.15s}
  .btn:hover{border-color:var(--pink);background:var(--pink-card)}
  .btn.primary{background:var(--pink);color:#fff;border-color:var(--pink)}
  .btn.primary:hover{background:var(--pink-deep)}
  .btn.danger{color:var(--bad)}
  .btn.small{padding:4px 10px;font-size:12px}

  /* ── 漏斗统计 ── */
  .funnel{display:flex;gap:6px;padding:14px 20px 4px;flex-wrap:wrap;align-items:center}
  .funnel .fcell{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px 12px;text-align:center;min-width:86px}
  .funnel .fcell b{display:block;font-size:20px;color:var(--pink-deep)}
  .funnel .fcell span{font-size:11px;color:var(--ink-mid)}
  .funnel .frate{font-size:11px;color:var(--ink-light);padding:0 2px}

  /* ── 工具条 ── */
  .toolbar{display:flex;gap:10px;padding:10px 20px;flex-wrap:wrap;align-items:center}
  .toolbar input[type=search]{width:220px}
  .chip{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:4px 12px;font-size:12px;color:var(--ink-mid)}
  .chip.on{background:var(--pink);color:#fff;border-color:var(--pink)}
  .chip.warn-dot::before{content:"●";color:var(--warn);margin-right:4px;font-size:9px}

  /* ── 看板 ── */
  .board{display:flex;gap:12px;padding:12px 20px;overflow-x:auto;align-items:flex-start}
  .col{min-width:240px;flex:0 0 240px;background:rgba(255,255,255,.6);border:1px solid var(--line);border-radius:var(--radius);padding:10px}
  .col h3{font-size:13px;font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:8px}
  .col h3 .dot{width:8px;height:8px;border-radius:50%}
  .col h3 .cnt{margin-left:auto;font-size:11px;color:var(--ink-light);font-weight:400}
  .card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:8px;cursor:pointer;transition:.15s;position:relative}
  .card:hover{border-color:var(--pink);box-shadow:0 2px 8px rgba(194,65,107,.12)}
  .card .co{font-size:14px;font-weight:600}
  .card .role{font-size:12px;color:var(--ink-mid);margin:2px 0 6px}
  .card .meta{display:flex;gap:6px;flex-wrap:wrap;font-size:11px}
  .tag{border-radius:6px;padding:2px 7px;background:var(--pink-card);color:var(--pink-deep)}
  .tag.ddl-soon{background:#fdecea;color:var(--bad)}
  .tag.ddl-week{background:#faf0e0;color:var(--warn)}
  .tag.stale{background:#faf0e0;color:var(--warn)}
  .card .next{font-size:11px;color:var(--ink-light);margin-top:6px;border-top:1px dashed var(--line);padding-top:5px}
  .col .add{width:100%;background:none;border:1px dashed var(--line);border-radius:8px;color:var(--ink-light);padding:6px;font-size:12px}
  .col .add:hover{color:var(--pink);border-color:var(--pink)}

  /* ── 列表视图 ── */
  .listtable{width:calc(100% - 40px);margin:12px 20px;border-collapse:collapse;background:var(--card);border-radius:var(--radius);overflow:hidden;font-size:13px}
  .listtable th{background:var(--pink-card);color:var(--pink-deep);text-align:left;padding:9px 12px;font-size:12px;font-weight:600}
  .listtable td{padding:9px 12px;border-top:1px solid var(--line)}
  .listtable tr:hover td{background:var(--pink-bg)}
  .listtable tr{cursor:pointer}
  .st-badge{border-radius:6px;padding:2px 8px;font-size:11px;color:#fff;display:inline-block}

  /* ── 模态 ── */
  .mask{position:fixed;inset:0;background:rgba(61,43,51,.35);z-index:50;display:none;align-items:flex-start;justify-content:center;padding:40px 16px;overflow:auto}
  .mask.show{display:flex}
  .modal{background:var(--card);border-radius:16px;padding:22px;width:100%;max-width:520px}
  .modal h2{font-size:16px;color:var(--pink-deep);margin-bottom:14px}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .form-grid .full{grid-column:1/-1}
  .form-grid label{display:block;font-size:12px;color:var(--ink-mid);margin-bottom:4px}
  .mbtns{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}
  .hist{margin-top:14px;border-top:1px dashed var(--line);padding-top:10px}
  .hist li{list-style:none;font-size:12px;color:var(--ink-mid);padding:3px 0;display:flex;justify-content:space-between;gap:10px}
  .stageflow{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0 4px}
  .stageflow button{border-radius:8px;padding:5px 10px;font-size:12px;background:var(--pink-bg);border:1px solid var(--line);color:var(--ink-mid)}
  .stageflow button.cur{background:var(--pink);color:#fff;border-color:var(--pink)}
  .empty{padding:40px;text-align:center;color:var(--ink-light);font-size:13px}
  .qitem{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px;margin-bottom:10px;font-size:13px;line-height:1.6}
  .qmeta{font-size:12px;color:var(--ink-light);margin-top:4px}
  .empty b{color:var(--pink-deep)}
  .note{font-size:12px;color:var(--ink-light);padding:0 20px}
  /* ── 月历小卡（有事件才标记，点日期内联展开） ── */
  .calwrap{max-width:920px;margin:14px auto;background:var(--card);border:1px solid var(--line);border-radius:var(--radius-card);padding:18px}
  .cal-head{display:flex;align-items:center;gap:6px;margin-bottom:12px}
  .cal-head b{font-size:16px;color:var(--brand-deep);margin:0 6px}
  .cal-nav{border:1px solid var(--line);background:var(--card);border-radius:var(--radius-btn);width:30px;height:30px;color:var(--ink-mid);line-height:1}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
  .cal-wd{font-size:12px;color:var(--ink-light);text-align:center;padding:4px 0}
  .cal-cell{min-height:74px;border-radius:var(--radius-btn);padding:5px 7px;font-size:13px;border:1px solid transparent;cursor:pointer;text-align:left;background:none;color:var(--ink)}
  .cal-cell:hover{background:var(--paper-2)}
  .cal-cell.blank{cursor:default;min-height:74px}
  .cal-cell.blank:hover{background:none}
  .cal-cell.today{border-color:var(--brand)}
  .cal-cell.sel{background:var(--brand-soft)}
  .cal-cell .cal-ev-mini{font-size:11px;border-radius:4px;padding:1px 5px;margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;border:none;text-align:left;width:100%;cursor:pointer}
  .cal-cell .dots{display:flex;gap:3px;margin-top:4px;flex-wrap:wrap}
  .cal-cell .dots i{width:5px;height:5px;border-radius:50%;display:inline-block}
  .cal-panel{margin-top:10px;border-top:1px dashed var(--line-strong);padding-top:8px}
  .cal-ev{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:var(--radius-btn);font-size:13px;cursor:pointer}
  .cal-ev:hover{background:var(--paper-2)}
  .cal-ev .cdot{width:8px;height:8px;border-radius:50%;flex:0 0 8px}
  .cal-ev .ct{margin-left:auto;font-size:11px;color:var(--ink-light)}
  /* ── AI 区块 ── */
  .ai-box{background:var(--pink-bg);border-radius:8px;padding:8px 10px;margin-top:6px;font-size:12px;line-height:1.75;white-space:pre-wrap;color:var(--ink)}
  body.dark .ai-box{background:rgba(224,138,165,.08)}
  .ai-status{font-size:12px;color:var(--ink-mid);margin-top:6px;min-height:14px}
  .ai-status.err{color:var(--bad)}
  .qrow{display:flex;align-items:flex-start;gap:8px;margin-top:6px}
  .qrow .qt{flex:1}
  @media (max-width:640px){.form-grid{grid-template-columns:1fr}.toolbar input[type=search]{width:100%}}

  /* ══════════ UI v2 · Paper Ledger → Warm-white spec (2026-09-07 定稿) ══════════ */
  /* A 暖白底，无纹理（规范：#F5F4F0 替代纯白，不加装饰底纹） */

  /* B·D 三级圆角制度：卡片 18 / 控件 8 / 药丸全圆 */
  .card,.col,.modal,.qitem,.listtable,.calwrap,.stat{border-radius:var(--radius-card)}
  .btn,.cal-nav,input,select,textarea{border-radius:var(--radius-btn)}
  .chip{border-radius:var(--radius-pill)}

  /* E 按钮：克制 hover——背景只提一级，不变色不加动画 */
  .btn{box-shadow:0 1px 0 var(--line-strong)}
  .btn:hover{background:var(--paper-2)}
  .btn.primary{background:var(--brand);color:#fff;border-color:var(--brand)}
  .btn.primary:hover{background:var(--brand-deep);color:#fff}

  /* C 状态用色点，不用彩色徽章 */
  .st-dot{width:9px;height:9px;border-radius:50%;display:inline-block;flex:0 0 9px}
  .st-badge{background:none;color:var(--ink-mid);padding:0;display:inline-flex;align-items:center;gap:6px;font-size:12px}
  .tag{background:var(--paper-2);color:var(--ink-mid)}
  .tag.ddl-soon{background:#fbe4ec;color:var(--bad)}
  .tag.ddl-week{background:#faf0e0;color:var(--warn)}
  .tag.stale{background:var(--accent-soft);color:var(--accent-deep)}

  /* 大数字区 · 首屏唯一焦点（规范：40-48px，只放 3 个） */
  .stats{display:flex;gap:14px;padding:16px 20px 2px;flex-wrap:wrap;align-items:flex-end}
  .stat{background:none;border:none;padding:2px 0;min-width:132px;box-shadow:none}
  .stat .lb{font-size:12px;color:var(--ink-mid);margin-bottom:1px}
  .stat .nm{font-size:44px;font-weight:700;color:var(--ink);line-height:1.06;letter-spacing:-.02em}
  .stat.hl .nm{color:var(--brand)}
  .stat .sub2{font-size:11px;color:var(--ink-light);margin-top:2px}
  /* 今日焦点行：可点击数字，数据在它该在的位置（非提示条） */
  .focusline{display:flex;gap:8px;padding:10px 20px 0;flex-wrap:wrap;align-items:center}
  .focusline .fbtn{background:var(--card);border:1px solid var(--line);border-radius:var(--radius-pill);padding:4px 14px;font-size:12px;color:var(--ink-mid);display:inline-flex;align-items:center;gap:6px}
  .focusline .fbtn b{font-size:14px;color:var(--brand)}
  .focusline .fbtn:hover{border-color:var(--brand)}

  /* 看板：列固定 272px 横向滚动，绝不压缩 */
  .board{gap:14px;padding:14px 20px 20px}
  .col{min-width:272px;flex:0 0 272px;background:var(--paper-2);border:1px solid var(--line);padding:12px}
  .col h3{font-size:13px;margin:0 -12px 10px;padding:8px 14px;letter-spacing:.01em;background:none;border-top:none;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:6px}
  .col h3 .dot{width:9px;height:9px;border-radius:50%}
  .col h3 .cnt{color:var(--ink-light);font-weight:400}

  /* 卡片：左侧 3px 状态色条 + hover 背景提一级（不加浮起动画） */
  .card{border:1px solid var(--line);border-left:3px solid var(--st,var(--ink-light));padding:11px 13px;margin-bottom:9px;transition:border-color .14s,background .14s}
  .card:hover{background:var(--brand-soft);border-color:var(--line-strong);border-left-color:var(--st,var(--brand))}
  .card .co{font-size:14px;font-weight:600;letter-spacing:-.01em;padding-right:14px}
  .card .role{font-size:12.5px;color:var(--ink-mid);margin:1px 0 7px}
  .card .next{border-top:1px dashed var(--line-strong)}

  /* 0.5 小元素：需跟进 = 右上角「催」字陶土药丸（功能性标记，一眼可见） */
  .card.has-follow::after{content:"催";position:absolute;top:-6px;right:-4px;background:var(--accent);color:#fff;font-size:11px;font-weight:600;padding:2px 8px;border-radius:var(--radius-pill);box-shadow:0 1px 0 var(--accent-deep);letter-spacing:.05em}

  /* 拖拽换状态 */
  .col.drag-over{border-color:var(--brand);border-style:dashed;background:var(--brand-soft)}
  .card[draggable=true]:active{cursor:grabbing;opacity:.85}
  .board.drop-hint .col::before{content:"拖到目标列";display:block;text-align:center;font-size:11px;color:var(--ink-light);margin-bottom:6px}

  /* 头部等级条（游戏化，静默常驻） */
  .lvbar{display:flex;align-items:center;gap:10px;padding:8px 20px;background:var(--paper-2);border-bottom:1px solid var(--line);font-size:12px;flex-wrap:wrap}
  .lvbar .lv{border:1px solid var(--line);color:var(--ink-mid);border-radius:var(--radius-pill);padding:2px 10px;font-weight:600;font-size:12px;white-space:nowrap}
  .lvbar .lvname{color:var(--brand-deep);font-weight:600;white-space:nowrap}
  .lvbar .track{flex:1;min-width:120px;height:6px;background:var(--paper-3);border-radius:var(--radius-pill);overflow:hidden}
  .lvbar .fill{height:100%;background:var(--brand);border-radius:var(--radius-pill);transition:width .4s}
  .lvbar .en{color:var(--accent-deep);font-weight:600;white-space:nowrap}

  /* 状态下拉（列表视图直改） */
  .st-select{font-size:12px;padding:3px 6px;border:1px solid var(--line);border-radius:var(--radius-btn);background:var(--card);color:var(--ink);width:auto;cursor:pointer}

  /* 日程徽章 */
  .tag.ev{background:var(--brand-soft);color:var(--brand-deep)}

  .col .add{border-radius:var(--radius-btn)}
  .col .add:hover{color:var(--brand);border-color:var(--brand);background:var(--brand-soft)}
  .chip.on{background:var(--brand);color:#fff;border-color:var(--brand)}
  .chip:hover{border-color:var(--brand)}
  .chip.warn-dot::before{color:var(--accent)}
  .funnel .fcell b{font-size:22px;color:var(--brand)}
  .listtable th{background:var(--paper-3);color:var(--ink)}
  .modal h2,.empty b{color:var(--brand-deep)}
  .stageflow button.cur{background:var(--brand);color:#fff;border-color:var(--brand)}
  .cal-cell.today{border-color:var(--brand)}
  .cal-cell.sel{background:var(--brand-soft)}
  .cal-head b{color:var(--brand-deep)}
  header h1{color:var(--brand-deep)}
  .ai-box{background:var(--paper-2)}
  .btn.more{padding:7px 11px;font-weight:600;letter-spacing:.08em}
  .menu{position:absolute;right:0;top:calc(100% + 6px);background:var(--card);border:1px solid var(--line);border-radius:var(--radius-card);box-shadow:0 8px 24px rgba(45,42,38,.14);padding:6px;min-width:168px;z-index:60;display:none}
  .menu.show{display:block}
  .menu button{display:block;width:100%;text-align:left;background:none;border:none;padding:8px 12px;font-size:13px;color:var(--ink);border-radius:var(--radius-btn)}
  .menu button:hover{background:var(--brand-soft);color:var(--brand-deep)}
  .hmore{position:relative}
  @media (max-width:640px){.stat .nm{font-size:34px}.stat{min-width:104px;padding:12px 16px}}

  /* ══════════ v7 · 航海志借鉴：行卡主视图 + 今日最小行动 + AI 深度分析 ══════════ */
  /* 行卡列表（主视图）：一行一个岗位，信息密度高 */
  .rows{padding:12px 20px;max-width:1080px;margin:0 auto}
  .rowcard{display:flex;gap:14px;align-items:flex-start;background:var(--card);border:1px solid var(--line);border-radius:var(--radius-card);padding:13px 18px;margin-bottom:10px;cursor:pointer;transition:background .14s,border-color .14s}
  .rowcard:hover{background:var(--paper-2);border-color:var(--line-strong)}
  .rowcard .r-top{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
  .rowcard .r-top b{font-size:15px;letter-spacing:-.01em}
  .rowcard .r-role{font-size:13px;color:var(--ink-mid)}
  .rowcard .r-meta{display:flex;gap:8px 14px;flex-wrap:wrap;font-size:12px;color:var(--ink-mid);margin-top:6px;align-items:center}
  .rowcard .r-meta .st-pill{border-radius:var(--radius-pill);padding:2px 10px;font-size:12px;font-weight:600;white-space:nowrap}
  .rowcard .r-next{font-size:12px;color:var(--ink-light);margin-top:7px;border-top:1px dashed var(--line);padding-top:6px}
  .rowcard .r-side{margin-left:auto;display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex:0 0 auto}
  .rowcard .r-date{font-size:11px;color:var(--ink-light)}
  .rowcard .st-select{border-radius:var(--radius-pill);padding:4px 10px;font-weight:600}
  /* 今日最小行动：从数据推导的一条行动（非提示条，点击直达岗位） */
  .todaycard{display:flex;align-items:center;gap:12px;max-width:1080px;margin:10px 20px 0;background:var(--card);border:1px solid var(--line);border-left:3px solid var(--brand);border-radius:var(--radius-card);padding:11px 16px;cursor:pointer}
  .todaycard:hover{background:var(--paper-2)}
  .todaycard .tc-lb{font-size:11px;color:var(--brand);font-weight:700;white-space:nowrap}
