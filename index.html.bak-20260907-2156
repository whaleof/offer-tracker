<script>
"use strict";
/* ═══════════ ① CONFIG 配置区（加状态/加字段只动这里） ═══════════ */
const CONFIG = {
  DATA_VERSION: 6,          // 数据结构版本：变更 +1 并在 STORE.migrate 写迁移
  LS_KEY: "job-tracker-v1",
  STALE_DAYS: 7,            // 已投后超过 N 天无状态变化 → 标「无进展」
  // 游戏化激励（学航海志，静默版：不弹窗不撒花，只在头部等级条上显示）
  GAME: {
    POINTS: { add:5, advance:10, review:10, offer:50 },   // 动作→积分
    LEVELS: [                                            // 累计积分→等级
      { at:0,   name:"新兵" }, { at:50,  name:"侦察兵" }, { at:150, name:"突击手" },
      { at:300, name:"主攻手" }, { at:500, name:"常胜将军" }, { at:800, name:"Offer收割机" },
    ],
  },
  // AI 提供方（OpenAI 兼容）。Key 只存访客自己浏览器（localStorage），绝不硬编码进仓库
  AI_PROVIDERS: {
    deepseek: { name:"DeepSeek（便宜，几分钱/次）", base:"https://api.deepseek.com", model:"deepseek-chat" },
    glm:      { name:"智谱 glm-4-flash（有免费额度）", base:"https://open.bigmodel.cn/api/paas/v4", model:"glm-4-flash" },
  },
  STAGES: [
    { id:"pool",      name:"待投递",   color:"#888780", icon:"📋" },
    { id:"applied",   name:"已投递",   color:"#378ADD", icon:"📮" },
    { id:"test",      name:"测评/笔试", color:"#BA7517", icon:"✍️" },
    { id:"interview", name:"面试中",   color:"#7F77DD", icon:"🎤" },
    { id:"offer",     name:"Offer",   color:"#639922", icon:"🏅" },
    { id:"rejected",  name:"挂了",     color:"#E24B4A", icon:"🕊️" },
  ],
  // 表单字段：type 支持 text/select/date/textarea；span=2 占满一行
  FIELDS: [
    { key:"company",  label:"公司名称 *", type:"text",   required:true },
    { key:"role",     label:"岗位名称 *", type:"text",   required:true },
    { key:"city",     label:"城市",       type:"text" },
    { key:"channel",  label:"投递渠道",   type:"text",   ph:"官网 / BOSS / 内推…" },
    { key:"deadline", label:"网申截止 DDL", type:"date" },
    { key:"resume",   label:"简历版本",   type:"text",   ph:"如：A公司AI产品版 v3" },
    { key:"salary",   label:"薪资范围",   type:"text",   ph:"可不填" },
    { key:"status",   label:"当前状态",   type:"select", options:"STAGES" },
    { key:"next",     label:"下一步动作", type:"text",   span:2, ph:"如：等测评邮件 / 周五前催HR" },
    { key:"jd",       label:"JD 原文（粘贴进来，AI 深度分析要用）", type:"textarea", span:2, rows:4, ph:"把招聘页的岗位描述整段粘贴到这里" },
    { key:"notes",    label:"备注（内推人 / 注意事项）", type:"textarea", span:2, rows:2 },
  ],
};
const stageOf = id => CONFIG.STAGES.find(s=>s.id===id) || CONFIG.STAGES[0];

/* ═══════════ ② STORE 数据层（唯一入口，别绕过它改数据） ═══════════ */
const STORE = {
  data: { version: CONFIG.DATA_VERSION, jobs: [] },
  load(){
    try{ const raw = localStorage.getItem(CONFIG.LS_KEY);
      if(raw) this.data = this.migrate(JSON.parse(raw));
    }catch(e){ console.error("读取失败", e); }
    return this.data;
  },
  save(){ localStorage.setItem(CONFIG.LS_KEY, JSON.stringify(this.data)); },
  migrate(d){
    if(!d.version) d.version = 1;
    if(!Array.isArray(d.jobs)) d.jobs = [];
    if(d.version < 2) d.version = 2;            // v2：岗位新增 reviews（面试复盘），旧数据补空数组即可
    if(d.version < 3) d.version = 3;            // v3：复盘新增 advice（AI 思路）、岗位新增 greeting（AI 打招呼语）
    if(d.version < 4) d.version = 4;            // v4：游戏化积分 + 岗位日程
    if(d.version < 5) d.version = 5;            // v5：岗位新增 jd（JD 原文）+ analysis（AI 深度分析结果）
    if(d.version < 6) d.version = 6;            // v6：岗位新增 checks（备考/准备清单）
    if(!d.meta || typeof d.meta!=="object") d.meta = {};   // 无条件保证存在（演示数据/导入数据都可能带 v4 版本号但缺 meta）
    if(typeof d.meta.points !== "number") d.meta.points = 0;
    d.jobs.forEach(j=>{
      if(!Array.isArray(j.reviews)) j.reviews = [];
      j.reviews.forEach(r=>{ if(!r.advice || typeof r.advice!=="object") r.advice = {}; });
      if(typeof j.greeting !== "string") j.greeting = "";
      if(!Array.isArray(j.events)) j.events = [];   // 面试/测评日程节点：{date,time,label}
      if(typeof j.jd !== "string") j.jd = "";       // v5：JD 原文（AI 深度分析输入）
      if(!j.analysis || typeof j.analysis!=="object") j.analysis = { prep:"", match:"" };  // v5：AI 深度分析结果
      if(typeof j.analysis.prep !== "string") j.analysis.prep = "";
      if(typeof j.analysis.match !== "string") j.analysis.match = "";
      if(!Array.isArray(j.checks)) j.checks = [];   // v6：备考/准备清单 [{t,done}]
    });
    return d;
  },
  /* ── 游戏化积分（静默）：只在头部等级条显示，不弹窗打扰 ── */
  points(n){ if(!this.data.meta) this.data.meta = { points:0 }; this.data.meta.points = Math.max(0,(this.data.meta.points||0)+n); this.save(); },
  level(){
    const p = (this.data.meta && this.data.meta.points) || 0;
    const L = CONFIG.GAME.LEVELS;
    let cur = L[0], next = null;
    L.forEach((l,i)=>{ if(p >= l.at){ cur = l; next = L[i+1] || null; } });
    const base = cur.at, ceil = next ? next.at : cur.at;
    return { lv: L.indexOf(cur)+1, name: cur.name, p, next, pct: next ? Math.min(100, Math.round((p-base)/(ceil-base)*100)) : 100 };
  },
  add(job){
    job.id = Date.now() + "" + Math.floor(Math.random()*1e4);
    job.history = [{ status: job.status || "pool", at: new Date().toISOString() }];
    job.createdAt = job.updatedAt = new Date().toISOString();
    if(!Array.isArray(job.events)) job.events = [];
    this.data.jobs.unshift(job); this.save();
    this.points(CONFIG.GAME.POINTS.add);
  },
  update(id, patch, moveStatus){
    const j = this.data.jobs.find(x=>x.id===id); if(!j) return;
    const changed = moveStatus && moveStatus !== j.status; // 必须在合并前比较，否则旧状态被覆盖、历史永远不记
    Object.assign(j, patch);
    if(changed){
      j.status = moveStatus;
      j.history.push({ status: moveStatus, at: new Date().toISOString() });
      // 状态推进给积分：前进 +10，到 Offer +50（回退不给不扣）
      const order = CONFIG.STAGES.findIndex(s=>s.id===j.status);
      const oldOrder = CONFIG.STAGES.findIndex(s=>s.id===(j.history.length>=2 ? j.history[j.history.length-2].status : j.status));
      if(order > oldOrder) this.points(order >= CONFIG.STAGES.findIndex(s=>s.id==="offer") ? CONFIG.GAME.POINTS.offer : CONFIG.GAME.POINTS.advance);
    }
    j.updatedAt = new Date().toISOString();
    this.save();
  },
  remove(id){ this.data.jobs = this.data.jobs.filter(x=>x.id!==id); this.save(); },
  addReview(id, r){
    const j = this.data.jobs.find(x=>x.id===id); if(!j) return;
    if(!Array.isArray(j.reviews)) j.reviews = [];
    r.at = new Date().toISOString();
    j.reviews.unshift(r); this.save();
    this.points(CONFIG.GAME.POINTS.review);
  },
  /* ── 日程节点（学航海志：状态变更 → 可选填时间 → 自动进月历） ── */
  addEvent(id, ev){
    const j = this.data.jobs.find(x=>x.id===id); if(!j) return;
    if(!Array.isArray(j.events)) j.events = [];
    j.events.push(ev); this.save();
  },
  removeReview(id, idx){
    const j = this.data.jobs.find(x=>x.id===id); if(!j || !j.reviews) return;
    j.reviews.splice(idx, 1); this.save();
  },
  addAdvice(id, rIdx, qText, text){
    // AI 生成的答题思路，按题目原文挂到对应复盘下（题目是 key，重生成直接覆盖）
    const j = this.data.jobs.find(x=>x.id===id); if(!j || !j.reviews || !j.reviews[rIdx]) return;
    if(!j.reviews[rIdx].advice || typeof j.reviews[rIdx].advice!=="object") j.reviews[rIdx].advice = {};
    j.reviews[rIdx].advice[qText] = text;
    j.updatedAt = new Date().toISOString();
    this.save();
  },
  replaceAll(d){ this.data = this.migrate(d); this.save(); },
  setAnalysis(id, key, text){
    const j = this.data.jobs.find(x=>x.id===id); if(!j) return;
    if(!j.analysis || typeof j.analysis!=="object") j.analysis = { prep:"", match:"" };
    j.analysis[key] = text;
    j.updatedAt = new Date().toISOString();
    this.save();
  },
  addCheck(id, text){
    const j = this.data.jobs.find(x=>x.id===id); if(!j || !text) return;
    if(!Array.isArray(j.checks)) j.checks = [];
    j.checks.push({ t: text, done: false }); this.save();
  },
  toggleCheck(id, idx){
    const j = this.data.jobs.find(x=>x.id===id); if(!j || !j.checks || !j.checks[idx]) return;
    j.checks[idx].done = !j.checks[idx].done; this.save();
  },
  removeCheck(id, idx){
    const j = this.data.jobs.find(x=>x.id===id); if(!j || !j.checks) return;
    j.checks.splice(idx, 1); this.save();
  },
};

/* ═══════════ ③ 工具函数 ═══════════ */
const $ = s => document.querySelector(s);
const esc = s => String(s??"").replace(/[&<>"]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const today = () => { const t=new Date(); t.setHours(0,0,0,0); return t; };
function daysUntil(dateStr){ if(!dateStr) return null; return Math.round((new Date(dateStr+"T00:00:00") - today())/864e5); }
function daysSince(iso){ return Math.floor((today() - new Date(iso))/864e5); }
function fmtDate(iso){ return iso ? iso.slice(0,10) : "—"; }
function ddlTag(d){
  const n = daysUntil(d);
  if(n===null) return "";
  if(n<0)   return `<span class="tag ddl-soon">DDL已过 ${-n}天</span>`;
  if(n<=3)  return `<span class="tag ddl-soon">⏳还剩${n}天</span>`;
  if(n<=7)  return `<span class="tag ddl-week">还剩${n}天</span>`;
  return `<span class="tag">DDL ${d.slice(5)}</span>`;
}
function staleTag(j){
  // 已投/测评/面试中 且 状态更新超过 N 天 → 提示可催
  if(["pool","offer","rejected"].includes(j.status)) return "";
  const d = daysSince(j.updatedAt);
  return d >= CONFIG.STALE_DAYS ? `<span class="tag stale">已${d}天无进展</span>` : "";
}
function isoDay(d){ return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0"); }
// 月历事件聚合（纯函数）：DDL 红 / 投递 蓝 / 面试复盘 粉
const CAL = {
  TYPES: { ddl:{label:"DDL", color:"#E24B4A"}, applied:{label:"投递", color:"#378ADD"}, review:{label:"复盘", color:"#BA7517"}, event:{label:"日程", color:"#7F77DD"} },
  eventsByDate(jobs){
    const map = {};
    const put = (date,type,jobId,extra,time)=>{ if(!date) return;
      (map[date] = map[date]||[]).push({ type, jobId, time, ...extra }); };
    jobs.forEach(j=>{
      if(j.deadline && daysUntil(j.deadline) >= 0) put(j.deadline, "ddl", j.id, { text:j.company+" DDL" });
      if(j.appliedAt) put(String(j.appliedAt).slice(0,10), "applied", j.id, { text:"投递 "+j.company });
      (j.reviews||[]).forEach(r=> put(r.date || (r.at?String(r.at).slice(0,10):""), "review", j.id,
        { text:(j.company)+" "+(r.round||"复盘") }));
      (j.events||[]).forEach(e=> put(e.date, "event", j.id, { text:(e.label||"日程")+" "+j.company }, e.time||""));
    });
    return map;
  },
};

/* ═══════════ ④ VIEWS 视图层 ═══════════ */
const VIEWS = {
  filter: { q:"", stage:"all" },
  calMonth: null,   // "2026-09"，null=当月
  calSel: null,     // 选中的日期 "2026-09-10"

  visibleJobs(){
    const f = this.filter;
    if(["__pool","__ddl","__stale"].includes(f.stage)) return STORE.data.jobs.filter(j=>{
      if(f.stage==="__pool" && j.status!=="pool") return false;
      if(f.stage==="__stale" && staleTag(j)==="") return false;
      if(f.stage==="__ddl"){ const d=daysUntil(j.deadline); if(j.status==="rejected"||d===null||d<0||d>7) return false; }
      if(f.q && !(j.company+j.role+(j.notes||"")).toLowerCase().includes(f.q.toLowerCase())) return false;
      return true;
    });
    return STORE.data.jobs.filter(j=>{
      if(f.stage!=="all" && j.status!==f.stage) return false;
      if(f.q && !(j.company+j.role+(j.notes||"")).toLowerCase().includes(f.q.toLowerCase())) return false;
      return true;
    });
  },

  funnel(){
    // v6：转化率已并入大数字区下的今日焦点行，此处保留空实现以兼容旧调用
    return "";
  },

  todayCard(){
    // 今日最小行动（学航海志「今日航海建议」）：从投递状态推导一条，点击直达岗位
    const js = STORE.data.jobs;
    let pick = null, act = "";
    let upEv = null, upJob = null;
    js.forEach(j=>(j.events||[]).forEach(e=>{
      if(!e.date) return;
      const d = new Date(e.date+"T23:59:59");
      if(d >= today() && (!upEv || e.date < upEv.date)){ upEv = e; upJob = j; }
    }));
    if(upJob){
      const n = daysUntil(upEv.date);
      pick = upJob;
      act = n <= 0 ? `今天就是「${upJob.company}」${upEv.label||"日程"} —— 过一遍题库和自我介绍`
                   : `「${upJob.company}」${upEv.label||"日程"} 还剩 ${n} 天 —— ${n<=2?"今晚":"这两天"}准备 JD 关键词和预测问题`;
    }else{
      const ddl = js.filter(j=>{ const d=daysUntil(j.deadline); return j.status==="pool" && d!==null && d<=3; })
                    .sort((a,b)=>daysUntil(a.deadline)-daysUntil(b.deadline))[0];
      if(ddl){ pick = ddl; act = `「${ddl.company}」DDL 还剩 ${daysUntil(ddl.deadline)} 天 —— 今天投出去`; }
      else{
        const stale = js.find(j=>staleTag(j)!=="");
        if(stale){ pick = stale; act = `「${stale.company}」已超 ${CONFIG.STALE_DAYS} 天无进展 —— 今天催一下，或放下转投`; }
        else{
          const pool = js.find(j=>j.status==="pool");
          if(pool){ pick = pool; act = `从待投递里挑一家（比如「${pool.company}」），今天投出去`; }
        }
      }
    }
    if(!pick) return "";
    return `<div class="todaycard" onclick="UI.openDetail('${pick.id}')">
      <span class="tc-lb">今日最小行动</span>
      <span class="tc-tx">${esc(act)}</span>
      <span class="tc-go">去准备 →</span>
    </div>`;
  },

  stats(){
    const js = STORE.data.jobs;
    const n = id => js.filter(j=>j.status===id).length;
    const applied = js.filter(j=>j.status!=="pool").length;
    const iv = n("interview"), of = n("offer");
    const stale = js.filter(j=>staleTag(j)!=="").length;
    const ddlSoon = js.filter(j=>{ const d=daysUntil(j.deadline); return j.status!=="rejected" && d!==null && d>=0 && d<=7; }).length;
    const cell = (lb,nm,sub,hl) => `<div class="stat${hl?" hl":""}"><div class="lb">${lb}</div><div class="nm">${nm}</div><div class="sub2">${sub}</div></div>`;
    const fb = (lb,nm,filter) => filter ? `<button class="fbtn" onclick="VIEWS.filter.stage=VIEWS.filter.stage==='${filter}'?'all':'${filter}';renderMain()">${lb} <b>${nm}</b></button>` : "";
    return `<div class="stats">
      ${cell("已投递",applied,`共 ${js.length} 个岗位`,false)}
      ${cell("面试中",iv,iv?"正在推进":"暂无",iv>0)}
      ${cell("Offer",of,of?"有回音了":"继续投",of>0)}
    </div>
    <div class="focusline">
      ${fb("待投递",n("pool"),"__pool")}${fb("DDL 7 天内",ddlSoon,"__ddl")}${fb("需跟进",stale,"__stale")}
      <span style="flex:1"></span>
      <span style="font-size:11px;color:var(--ink-light)">转化：投→面 ${(()=>{const a=applied;return a?Math.round(iv/a*100)+"%":"—"})()} · 面→offer ${iv?Math.round(of/iv*100)+"%":"—"}</span>
    </div>`;
  },

  levelBar(){
    const l = STORE.level();
    const nextTxt = l.next ? `再 ${l.next.at - l.p} 分升 ${l.next.name}` : "已满级";
    return `<div class="lvbar">
      <span class="lv">Lv.${l.lv}</span><span class="lvname">${l.name}</span>
      <div class="track"><div class="fill" style="width:${l.pct}%"></div></div>
      <span style="color:var(--ink-light)">${nextTxt}</span>
      <span class="en">⚡ ${l.p}</span>
    </div>`;
  },

  board(){
    const vis = this.visibleJobs();
    const cols = CONFIG.STAGES.map(s=>{
      const cards = vis.filter(j=>j.status===s.id).map(j=>this.card(j)).join("");
      return `<div class="col" style="--stc:${s.color};--stc-soft:${s.color}1A" ondragover="event.preventDefault();this.classList.add('drag-over')" ondragleave="this.classList.remove('drag-over')" ondrop="event.preventDefault();this.classList.remove('drag-over');UI.dropCard(event,'${s.id}')">
        <h3><span class="dot" style="background:${s.color}"></span>${s.icon||""} ${s.name}
          <span class="cnt">${vis.filter(j=>j.status===s.id).length}</span></h3>
        ${cards || ""}
        <button class="add" onclick="UI.openForm(null,'${s.id}')">＋ 加到「${s.name}」</button>
      </div>`;
    }).join("");
    return `<div class="board">${cols}</div>`;
  },

  card(j){
    const st = stageOf(j.status);
    const stale = staleTag(j);
    const follow = stale !== "";
    const tt = follow ? ` title="超 ${CONFIG.STALE_DAYS} 天无进展，点开可推进状态"` : "";
    const ev = (j.events&&j.events[j.events.length-1]) || null;
    return `<div class="card${follow?" has-follow":""}" style="--st:${st.color}"${tt} draggable="true" ondragstart="UI.dragCard(event,'${j.id}')" onclick="UI.openDetail('${j.id}')">
      <div class="co">${esc(j.company)}</div>
      <div class="role">${esc(j.role)}${j.city? " · 📍"+esc(j.city):""}</div>
      <div class="meta">
        <span class="tag"><span class="st-dot" style="background:${st.color}"></span>${st.name}</span>
        ${ddlTag(j.deadline)}${stale}${ev?`<span class="tag ev">📅 ${esc(ev.label)} ${esc(ev.date.slice(5))}${ev.time?" "+esc(ev.time):""}</span>`:""}${j.resume?`<span class="tag">简历·${esc(j.resume)}</span>`:""}
      </div>
      ${j.next? `<div class="next">→ ${esc(j.next)}</div>`:""}
    </div>`;
  },

  table(){
    // v7 主视图：行卡列表（学航海志）——一行一岗，右侧状态下拉直改（改状态顺手弹日程窗）
    const vis = this.visibleJobs();
    if(!vis.length) return `<div class="empty">没有匹配的岗位</div>`;
    const rows = vis.map(j=>{
      const st = stageOf(j.status);
      const ev = (j.events&&j.events[j.events.length-1]) || null;
      const evSoon = ev && (()=>{ const d=daysUntil(ev.date); return d!==null && d>=0 && d<=2; })();
      return `<div class="rowcard" onclick="UI.openDetail('${j.id}')">
        <div class="r-main" style="flex:1;min-width:0">
          <div class="r-top"><b>${esc(j.company)}</b><span class="r-role">${esc(j.role)}</span></div>
          <div class="r-meta">
            <span class="st-pill" style="background:${st.color}1A;color:${st.color}">${st.icon||""} ${st.name}</span>
            ${j.city?`<span>📍 ${esc(j.city)}</span>`:""}
            ${j.channel?`<span>💬 ${esc(j.channel)}</span>`:""}
            ${j.salary&&j.salary!=="—"?`<span>💰 ${esc(j.salary)}</span>`:""}
            ${j.resume?`<span>📄 ${esc(j.resume)}</span>`:""}
            ${j.deadline?`<span>${ddlTag(j.deadline)}</span>`:""}
            ${staleTag(j)}
            ${ev?`<span class="${evSoon?"ev-soon":""}">📅 ${esc(ev.label)} ${esc(ev.date.slice(5))}${ev.time?" "+esc(ev.time):""}${evSoon?" · 快到了":""}</span>`:""}
          </div>
          ${j.next?`<div class="r-next">→ ${esc(j.next)}</div>`:""}
        </div>
        <div class="r-side">
          <select class="st-select" style="border-color:${st.color};color:${st.color}" onclick="event.stopPropagation()"
            onchange="UI.moveStatus('${j.id}',this.value);renderMain()">
            ${CONFIG.STAGES.map(s=>`<option value="${s.id}" ${j.status===s.id?"selected":""}>${s.icon||""} ${s.name}</option>`).join("")}
          </select>
          <span class="r-date">${j.appliedAt? esc(fmtDate(j.appliedAt)) : "未投"}</span>
        </div>
      </div>`;
    }).join("");
    return `<div class="rows">${rows}</div>`;
  },

  resumeView(){
    // 简历版本管理（轻）：按「简历版本」聚合——每个版本投到哪、走到多远，看出哪个版本好回
    const js = STORE.data.jobs.filter(j=>j.resume && j.resume.trim());
    if(!js.length) return `<div class="empty" style="margin-top:40px">
      <b>还没有岗位填过简历版本</b>
      <div style="font-size:12px;color:var(--ink-light);margin-top:6px">编辑岗位时填「简历版本」，这里就能对比每个版本走到多远</div></div>`;
    const groups = {};
    js.forEach(j=>{ const k=j.resume.trim(); (groups[k] = groups[k]||[]).push(j); });
    const keys = Object.keys(groups).sort((a,b)=>groups[b].length-groups[a].length);
    const cards = keys.map(k=>{
      const arr = groups[k];
      const n = id => arr.filter(j=>j.status===id).length;
      const live = n("applied")+n("test")+n("interview")+n("offer");
      const cos = arr.map(j=>`<button class="rv-co" onclick="UI.openDetail('${j.id}')">${esc(j.company)}<i style="color:${stageOf(j.status).color}">${stageOf(j.status).name}</i></button>`).join("");
      return `<div class="rvcard">
        <div class="rv-top"><b>📄 ${esc(k)}</b>
          <span class="rv-cnt">投出 ${arr.filter(j=>j.status!=="pool").length} · 有效进行中 ${live}</span></div>
        <div class="rv-nums">
          <span><b>${n("applied")}</b> 已投</span><span><b>${n("test")}</b> 测评</span>
          <span><b>${n("interview")}</b> 面试</span><span><b>${n("offer")}</b> Offer</span>
          <span><b>${n("rejected")}</b> 挂</span>
        </div>
        <div class="rv-cos">${cos}</div>
      </div>`;
    }).join("");
    return `<div class="rvcards">${cards}</div>`;
  },

  qbank(){
    // 题库：聚合所有岗位复盘里被问过的题，面试前按公司过一遍
    const items = [];
    STORE.data.jobs.forEach(j=>(j.reviews||[]).forEach((r,ri)=>
      (r.questions||[]).forEach((q,qi)=>items.push({q, co:j.company, round:r.round||"", date:r.date||fmtDate(r.at), jobId:j.id, ri, qi, advice:(r.advice||{})[q]||""}))));
    this._qitems = items;
    items.sort((a,b)=>String(b.date||"").localeCompare(String(a.date||"")));
    if(!items.length) return `<div class="empty" style="margin-top:40px">
      <b>题库还是空的</b>
      <div style="font-size:12px;color:var(--ink-light);margin-top:6px">面试完在岗位详情里「＋ 添加复盘」，被问倒的题会汇到这里</div></div>`;
    return `<div style="font-size:12px;color:var(--ink-light);margin-bottom:10px">共 ${items.length} 道被问过的题 · 下次面试前按公司过一遍 · 点「思路」让 AI 给答题要点</div>` +
      items.map((it,i)=>`<div class="qitem"><div>${esc(it.q)}</div>
        ${it.advice? `<div class="ai-box" id="qb-adv-${i}">${esc(it.advice)}</div>`:""}
        <div class="ai-status" id="qb-st-${i}"></div>
        <div class="qmeta">${esc(it.co)} · ${esc(it.round)} · ${esc(it.date)}
          <button class="btn small" style="margin-left:8px;padding:2px 8px"
            onclick="AI.adviceQB(${i})">AI 思路</button>
        </div></div>`).join("");
  },

  calendar(){
    // 本土化月历：有事件才标记，点日期在下方内联展开，不做大日历主视图
    const now = new Date();
    const ym = this.calMonth || `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,"0")}`;
    const [y,m] = ym.split("-").map(Number);
    const startDow = (new Date(y, m-1, 1).getDay()+6)%7;   // 周一=0
    const dim = new Date(y, m, 0).getDate();
    const ev = CAL.eventsByDate(STORE.data.jobs);
    const todayStr = isoDay(today());
    if(this.calSel && !ev[this.calSel] && this.calSel!==todayStr) {} // 选中日无事件也展示空态
    const sel = this.calSel;
    const nav = (d)=>{
      const nd = new Date(y, m-1+d, 1);
      return `VIEWS.calMonth='${nd.getFullYear()}-${String(nd.getMonth()+1).padStart(2,"0")}';VIEWS.calSel=null;renderResults()`;
    };
    let cells = "";
    for(let i=0;i<startDow;i++) cells += `<div class="cal-cell blank"></div>`;
    for(let d=1;d<=dim;d++){
      const ds = `${ym}-${String(d).padStart(2,"0")}`;
      const es = ev[ds]||[];
      const minis = es.slice(0,2).map(e=>`<span class="cal-ev-mini" style="background:${CAL.TYPES[e.type].color}18;color:${CAL.TYPES[e.type].color}" onclick="event.stopPropagation();UI.openDetail('${e.jobId}')">${e.time? esc(e.time)+" ":""}${esc(e.text)}</span>`).join("");
      const more = es.length>2 ? `<span class="cal-ev-mini" style="color:var(--ink-light)">+${es.length-2}</span>` : "";
      cells += `<button class="cal-cell ${ds===todayStr?"today":""} ${ds===sel?"sel":""}"
        onclick="VIEWS.calSel=VIEWS.calSel==='${ds}'?null:'${ds}';renderResults()">${d}${minis}${more}</button>`;
    }
    let panel = "";
    if(sel){
      const es = ev[sel]||[];
      panel = `<div class="cal-panel"><b style="font-size:13px">${sel.slice(5)} ${es.length?"· "+es.length+" 件事":"· 没有安排"}</b>
        ${es.map(e=>`<div class="cal-ev" onclick="UI.openDetail('${e.jobId}')">
          <span class="cdot" style="background:${CAL.TYPES[e.type].color}"></span>
          ${CAL.TYPES[e.type].label} · ${esc(e.text)}<span class="ct">点击看详情 →</span></div>`).join("")}</div>`;
    }
    return `<div class="calwrap">
      <div class="cal-head">
        <button class="cal-nav" onclick="${nav(-1)}">‹</button><b>${y} 年 ${m} 月</b><button class="cal-nav" onclick="${nav(1)}">›</button>
        <span style="margin-left:auto;font-size:11px;color:var(--ink-light);display:flex;gap:8px">
          ${Object.values(CAL.TYPES).map(t=>`<span><i style="display:inline-block;width:6px;height:6px;border-radius:50%;background:${t.color};margin-right:3px"></i>${t.label}</span>`).join("")}
        </span>
      </div>
      <div class="cal-grid">${["一","二","三","四","五","六","日"].map(w=>`<div class="cal-wd">${w}</div>`).join("")}${cells}</div>
      ${panel}</div>`;
  },

  news(){
    const items = (NEWS.items||[]).slice().sort((a,b)=>String(b.date||"").localeCompare(String(a.date||"")));
    return `<div style="font-size:12px;color:var(--ink-light);margin-bottom:10px">共 ${items.length} 条情报 · 由 AI 活动雷达定期更新</div>` +
      items.map(n=>`<div class="qitem">
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          ${n.url? `<a href="${esc(n.url)}" target="_blank" rel="noopener" style="color:var(--pink-deep);text-decoration:none"><b>${esc(n.title)}</b></a>` : `<b>${esc(n.title)}</b>`}
          <span class="tag" style="margin-left:auto">${esc(n.tag||"情报")}</span>
        </div>
        ${n.note? `<div class="qmeta" style="margin-top:6px">${esc(n.note)}</div>`:""}
        <div class="qmeta">${esc(n.date||"")}${n.deadline? " · 截止 "+esc(n.deadline):""}</div>
      </div>`).join("");
  },
};

function renderMain(){
  const f = VIEWS.filter;
