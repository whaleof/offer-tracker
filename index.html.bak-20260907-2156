      <div style="font-size:12px;color:var(--ink-light);margin-top:8px">有备份 JSON？右上角 ⋯ › 导入</div>
    </div>`;
    return;
  }
  const chips = [`<button class="chip ${f.stage==='all'?'on':''}" onclick="VIEWS.filter.stage='all';renderMain()">🎯 全部</button>`]
    .concat(CONFIG.STAGES.map(s=>
      `<button class="chip ${f.stage===s.id?'on':''}" onclick="VIEWS.filter.stage='${s.id}';renderMain()">${s.icon} ${s.name}</button>`))
    .join("");
  $("#main").innerHTML =
    VIEWS.stats() +
    VIEWS.todayCard() +
    `<div class="toolbar">
      <input type="search" placeholder="搜公司 / 岗位 / 备注…" value="${esc(f.q)}"
        oninput="VIEWS.filter.q=this.value;renderResults()" style="caret-color:var(--brand)">
      ${chips}
      <span style="margin-left:auto"></span>
      <button class="btn small vbtn" data-v="table" onclick="VIEWS.filter.view='table';renderResults()">列表</button>
      <button class="btn small vbtn" data-v="board" onclick="VIEWS.filter.view='board';renderResults()">看板</button>
      <button class="btn small vbtn" data-v="cal" onclick="VIEWS.filter.view='cal';renderResults()">月历</button>
      <button class="btn small vbtn" data-v="resume" onclick="VIEWS.filter.view='resume';renderResults()">简历</button>
      <button class="btn small vbtn" data-v="qbank" onclick="VIEWS.filter.view='qbank';renderResults()">题库</button>
      <button class="btn small vbtn" data-v="news" id="newsBtn" style="display:none" onclick="VIEWS.filter.view='news';renderResults()">情报</button>
    </div>
    <div id="resultsArea"></div>`;
  NEWS.applyBtn();
  renderResults();
}
// 搜索时只重绘结果区，不动工具条 → 输入框光标/焦点不丢（踩坑库：全量重绘导致焦点/滚动丢失）
// v7：默认视图=行卡列表（航海志式），看板降为切换视图
function renderResults(){
  const area = $("#resultsArea"); if(!area) return;
  const v = VIEWS.filter.view || "table";
  area.innerHTML = v==="table" ? VIEWS.table()
                 : v==="qbank" ? VIEWS.qbank()
                 : v==="cal" ? VIEWS.calendar()
                 : v==="news" ? VIEWS.news()
                 : v==="resume" ? VIEWS.resumeView()
                 : v==="board" ? VIEWS.board()
                 : VIEWS.table();
  if(document.querySelectorAll) document.querySelectorAll(".vbtn").forEach(b=>{
    b.classList.toggle("on", b.dataset.v === v);
    b.style.borderColor = b.classList.contains("on") ? "var(--brand)" : "";
    b.style.color = b.classList.contains("on") ? "var(--brand)" : "";
  });
}
/* 「需跟进 / 待投递 / DDL」过滤已统一并入 visibleJobs */

/* ═══════════ ⑤ UI 交互（表单 / 详情） ═══════════ */
const UI = {
  editingId: null,

  open(mask){ $("#"+mask).classList.add("show"); },
  close(mask){ $("#"+mask).classList.remove("show"); },

  openForm(id=null, presetStage="pool"){
    this.editingId = id;
    const j = id ? STORE.data.jobs.find(x=>x.id===id) : { status: presetStage };
    $("#formTitle").textContent = id ? "编辑岗位" : "添加岗位";
    $("#formBody").innerHTML = CONFIG.FIELDS.map(f=>{
      const v = j[f.key] ?? "";
      const span = f.span? " full":"";
      if(f.type==="select"){
        const opts = CONFIG.STAGES.map(s=>`<option value="${s.id}" ${v===s.id?"selected":""}>${s.name}</option>`).join("");
        return `<div class="${span}"><label>${f.label}</label><select id="f_${f.key}">${opts}</select></div>`;
      }
      if(f.type==="textarea")
        return `<div class="${span}"><label>${f.label}</label><textarea id="f_${f.key}" rows="${f.rows||2}" placeholder="${f.ph||""}">${esc(v)}</textarea></div>`;
      return `<div class="${span}"><label>${f.label}</label><input id="f_${f.key}" type="${f.type}" value="${esc(v)}" placeholder="${f.ph||""}"></div>`;
    }).join("");
    this.open("formMask");
  },
  closeForm(){ this.close("formMask"); },

  saveForm(){
    const patch = {};
    let missing = null;
    for(const f of CONFIG.FIELDS){
      const v = $("#f_"+f.key).value.trim();
      if(f.required && !v){ missing = f.label; break; }
      patch[f.key] = v;
    }
    if(missing){ alert("请填写「"+missing+"」"); return; }
    if(patch.status==="applied" && !patch.appliedAt) patch.appliedAt = new Date().toISOString().slice(0,10);
    if(this.editingId){
      const old = STORE.data.jobs.find(x=>x.id===this.editingId);
      STORE.update(this.editingId, patch, patch.status!==old.status ? patch.status : null);
    }else{
      STORE.add(patch);
    }
    this.closeForm(); renderMain();
  },

  openDetail(id){
    const j = STORE.data.jobs.find(x=>x.id===id); if(!j) return;
    const st = stageOf(j.status);
    const flow = CONFIG.STAGES.map(s=>
      `<button class="${s.id===j.status?'cur':''}" style="border-color:${s.color};color:${s.id===j.status?'#fff':s.color};background:${s.id===j.status?s.color:'var(--pink-bg)'}"
        onclick="UI.moveStatus('${j.id}','${s.id}');UI.openDetail('${j.id}')">${s.icon||""} ${s.name}</button>`).join("");
    const hist = (j.history||[]).slice().reverse().map(h=>{
      const s = stageOf(h.status);
